# Copiar a .env (./bin/dev lo hace si falta). Nunca versionar .env.
COMPOSE_PROJECT_NAME=microapp
APP_PORT=3000

# Base de datos
POSTGRES_USER=app
POSTGRES_PASSWORD=cambiar-en-local
POSTGRES_DB=app
DATABASE_URL=postgresql://app:cambiar-en-local@postgres:5432/app

# Autenticacion. ./bin/dev genera el secreto al crear .env; a mano: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Administrador inicial para ./bin/seed (opcional)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Solo produccion (compose prod): imagenes publicadas en GHCR
GITHUB_REPOSITORY=hugovelez16/microapp-template
IMAGE_TAG=latest
